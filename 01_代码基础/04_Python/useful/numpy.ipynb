   "source": [
    "# 使用矩阵求解线性方程组"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "aa8c0fe9",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "A = np.array([[1, -2],[1, 3]])\n",
    "Y = np.array([-1, 0])\n",
    "\n",
    "# 求解线性方程组 AX = Y\n",
    "if np.linalg.det(A) == 0:\n",
    "    print(\"矩阵 A 是奇异的，无法求解线性方程组。\")\n",
    "X = np.linalg.solve(A, Y)\n",
    "\n",
    "print(X)"
   ]
  }
 ],
